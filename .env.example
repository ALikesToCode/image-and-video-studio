# The deployed MultiLLM Proxy origin. MULTILLM_PROXY_BASE_URL is also accepted.
PROXY_BASE_URL=https://multillm-proxy.cserules.workers.dev

# Optional: keep the proxy credential server-side. Users can instead enter a
# MultiLLM key in Settings, where the selected browser storage policy applies.
MULTILLM_API_KEY=YOUR_PROXY_API_KEY
